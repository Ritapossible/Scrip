{
  "name": "scrip",
  "version": "0.1.0",
  "description": "Scrip - machine-payable FXRP. Agents pay for what they use, priced in USD, settled on Flare.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "probe": "tsx scripts/probe.ts",
    "setup": "node scripts/setup-wallets.mjs",
    "fund": "tsx scripts/fund-payer.ts",
    "price": "tsx scripts/price.ts",
    "settle": "tsx scripts/settle.ts",
    "serve:x402": "tsx scripts/serve-x402.ts",
    "agent": "tsx scripts/agent.ts",
    "web": "node scripts/serve-web.mjs",
    "typecheck": "tsc --noEmit",
    "test:fork": "node scripts/settle-fork-test.mjs"
  },
  "keywords": [
    "flare",
    "fxrp",
    "fassets",
    "x402",
    "agentic-payments",
    "ftso",
    "eip-2612"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
