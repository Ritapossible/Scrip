# Coston2 testnet. Copy to .env and fill in, or let scripts/setup-wallets.mjs
# write it for you:
#
#   RELAYER_PK=0x<a funded wallet> npm run setup
#
RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Three throwaway wallets. Generate fresh - never reuse a key that has ever
# touched mainnet.
#
# PAYER holds FXRP and deliberately ZERO C2FLR. That zero is the whole proof:
# it is what makes the payment gasless from the agent's side. Never send this
# address gas - a wallet that has never received C2FLR is the only kind that
# satisfies the exact-zero check in settle.ts.
PAYER_PK=0x
#
# RELAYER holds C2FLR only. It pays every gas fee.
RELAYER_PK=0x
#
# PAYEE just receives. It needs nothing, and may be the relayer.
PAYEE_ADDRESS=0x

# Deployed and source-verified on Coston2.
FACILITATOR_ADDRESS=0x43F672C0a915F59A2472a07D2108936e217cB04C

# Port for the x402 facilitator service.
PORT=8402

# Signs invoice ids, so a returning payment proves this service issued the
# quote. Set it in anything that restarts: without it a random key is generated
# per process and quotes issued before a restart are rejected after it.
#
# This is an HMAC key and nothing else. It signs no transaction and derives no
# address, so it must NOT be a private key - reusing the relayer's key here
# would spread a funded key into another variable for no benefit. Any 32 random
# bytes will do:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCRIP_INVOICE_SECRET=

# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For
# (Railway, Render, Fly). Leave it unset locally: trusting the header when
# nothing sets it lets a client claim any IP and step around the rate limiter.
TRUST_PROXY=
